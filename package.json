{
  "name": "neighbourhood-car-share",
  "version": "1.0.0",
  "description": "Small neighbourhood car rental platform (max 10 users) with login, bookings, availability and a map.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "seed": "node scripts/seed.js",
    "build:hosted": "node scripts/build-hosted.js",
    "check:hosted": "node scripts/build-hosted.js --check",
    "test": "node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
