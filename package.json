{
  "name": "neighbourhood-car-share",
  "version": "1.0.0",
  "description": "Small neighbourhood car rental platform (max 10 users) with login, bookings, availability and a map.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test \"tests/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
